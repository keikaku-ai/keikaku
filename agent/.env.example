# Keikaku agent configuration. Copy to .env and keep .env private.

# Where this agent connects:
#   Keikaku Cloud:  https://api.keikaku.ai
#   Self-hosted:    https://<your-server>:9143
API_BASE_URL=https://api.keikaku.ai

# 'true' accepts a self-signed self-hosted cert; 'false' for Keikaku Cloud.
AGENT_INSECURE_TLS=false

# Create an agent in Keikaku (Agents → New agent) and paste its token:
AGENT_TOKEN=

# Starting model. After connecting, run the self-test in Keikaku and it will
# pick the best model for your hardware for each kind of work.
AGENT_MODEL=qwen2.5-coder:7b

# Ollama on the host (install it natively so it owns the GPU).
OLLAMA_URL=http://host.docker.internal:11434
