# Keikaku self-hosted configuration. Copy to .env and KEEP .env PRIVATE.

# Required: a long random string. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Hostname browsers reach this server on (LAN IP or domain). Affects the TLS cert.
SITE_ADDRESS=localhost

# First-boot admin. Leave ADMIN_PASSWORD blank to have one generated and printed
# in the container logs on first start.
ADMIN_EMAIL=admin@keikaku.local
ADMIN_PASSWORD=

HTTPS_PORT=9143
HTTP_PORT=9180
